{
  "name": "reels-studio",
  "type": "module",
  "repository": "https://github.com/avi2d/reels-studio",
  "author": "avi2d <avi2dg@gmail.com>",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts",
    "build": "checks-changelog && checks-effect-scope",
    "lint": "oxlint && checks-lint",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "test": "checks-test",
    "test:fast": "checks-test --changed",
    "test:unit": "checks-test --tier=unit",
    "test:e2e": "checks-test --tier=e2e"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.15.0",
    "@effect/platform-bun": "4.0.0",
    "effect": "4.0.0",
    "lucide-static": "1.75.0"
  },
  "devDependencies": {
    "@avi2dg/checks": "0.111.0",
    "@effect/tsgo": "0.45.0",
    "@hughescr/stryker-bun-runner": "1.4.0",
    "@stryker-mutator/core": "10.0.0",
    "@swc/core": "1.16.2",
    "@types/bun": "^1.4.2",
    "dependency-cruiser": "18.4.0",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  },
  "version": "0.1.0",
  "description": "A home-network web interface that cuts, styles and checks vertical videos",
  "packageManager": "bun@1.4.3",
  "overrides": {
    "minimatch": "11.0.3"
  }
}
